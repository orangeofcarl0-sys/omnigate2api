# omnigate2api API Key（只走环境变量，不落盘 git）
OMNIGATE_API_KEY=changeme

# 可选覆盖
# OMNIGATE_LISTEN=:7866
# OMNIGATE_AUTH_DIR=./auths
# OMNIGATE_STATE_FILE=./data/state.json
# OMNIGATE_DEFAULT_MODEL=snap-chat
# OMNIGATE_WATCH_ENABLED=true
# OMNIGATE_WATCH_POLL_MINUTES=30
# OMNIGATE_WATCH_REFRESH_SKEW=30
# 远程授权回调 host（如 https://oneapi.example.com/codearts），留空用本机 127.0.0.1
# OMNIGATE_OAUTH_CALLBACK_HOST=
