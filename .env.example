# omnigate2api API Key（只走环境变量，不落盘 git）
OMNIGATE_API_KEY=changeme

# 可选覆盖
# OMNIGATE_LISTEN=:7866
# OMNIGATE_AUTH_DIR=./auths
# OMNIGATE_STATE_FILE=./data/state.json
# OMNIGATE_DEFAULT_MODEL=snap-chat
# OMNIGATE_WATCH_ENABLED=true
# OMNIGATE_WATCH_POLL_MINUTES=30
# OMNIGATE_WATCH_REFRESH_SKEW=30
# 远程授权回调 host（如 https://oneapi.example.com/codearts），留空用本机 127.0.0.1
# OMNIGATE_OAUTH_CALLBACK_HOST=

# 出网代理（SPEC §24.7）：国际域直连极不稳（实测 6h 243 次 EOF/TLS 超时 → 客户端 503）。
# v2rayN 的 xray 入站 10808 是混合口，SOCKS5 与 HTTP CONNECT 都吃，不必另开 10809。
# 容器经 host.docker.internal 到宿主机回环；NO_PROXY 内的国内域直连（绕道出海只会更慢更不稳）。
# 注意：huaweicloud.com 与 myhuaweicloud.com 是两个父域，Go 的 NO_PROXY 不做跨父域覆盖，都要列。
# HTTPS_PROXY=http://host.docker.internal:10808
# NO_PROXY=copilot.tencent.com,codebuddy.cn,workbuddy.cn,myhuaweicloud.com,huaweicloud.com,localhost,127.0.0.1
